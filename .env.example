# ===========================================
# FluxGuardian — Environment Configuration
# Copy this file to .env and fill in values
# ===========================================

# --- OpenMetadata ---
# Use 127.0.0.1 (not localhost) — Python 3.13 resolves localhost to IPv6 first
OPENMETADATA_HOST=http://127.0.0.1:8585
OPENMETADATA_JWT_TOKEN=eyJ...

# --- GitHub App ---
# See SETUP.md Phase 7 for GitHub App creation steps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/Users/you/.ssh/fluxguardian.pem
GITHUB_WEBHOOK_SECRET=

# --- Claude (Anthropic) ---
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...
# "dev" uses claude-haiku-4-5, "prod" uses claude-sonnet-4-5
FLUXGUARDIAN_ENV=prod

# --- CORS (Optional) ---
# Comma-separated list of extra allowed frontend origins
# CORS_ALLOWED_ORIGINS=https://my-app.vercel.app,https://my-staging.vercel.app

# --- Slack (Optional) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# --- ngrok (Optional, for local webhook testing) ---
NGROK_AUTHTOKEN=

# --- App ---
APP_VERSION=1.0.0
LOG_LEVEL=INFO
